[Unit]
Description=Pokemon Roguelike FastAPI backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/pokemon-backend
Environment="PATH=/opt/pokemon-backend/venv/bin"
ExecStart=/opt/pokemon-backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
